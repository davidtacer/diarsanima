  "private": true,
  "scripts": {
    "dev": "tsx scripts/prebuild.ts && next dev",
    "build": "tsx scripts/prebuild.ts && next build && tsx scripts/postbuild.ts",
    "start": "next start",
    "lint": "eslint",
    "validate": "tsx scripts/validate.ts",
    "catalog": "tsx scripts/catalog.ts",
    "uploads": "tsx scripts/optimize-uploads.ts",
    "uploads:wp": "tsx scripts/fetch-wp-uploads.ts",
    "typecheck": "tsx scripts/prebuild.ts && tsc --noEmit",
    "check": "yarn validate && yarn catalog && yarn schema --check && yarn typecheck && yarn lint && yarn build",
    "schema": "tsx scripts/export-schema.ts"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "image-size": "^2.0.4",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "3.25",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "yarn@1.22.22",
