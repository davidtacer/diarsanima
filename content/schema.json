"},"image":{"type":"object","properties":{"src":{"type":"string","pattern":"^\\/uploads\\/[a-z0-9\\-_./]+\\.(jpg|jpeg|png|webp|avif|svg)$"},"alt":{"allOf":[{"type":"string","minLength":1,"maxLength":150},{"type":"string","minLength":3}]},"focal":{"type":"string","enum":["center","top","bottom","left","right"],"default":"center"}},"required":["src","alt"],"additionalProperties":false},"imageSide":{"type":"string","enum":["left","right"],"default":"right"},"showSignature":{"type":"boolean","default":false}},"required":["id","type","body"],"additionalProperties":false,"description":"Odstavki besedila z neobveznim naslovom razdelka. Podpira omejen Markdown: **krepko**, *ležeče* (izriše se v pisavi Bodoni), povezave [besedilo](page:slug) ali https://, alineje (- ). Varianta lead je večja in svetlejša (uvod), body je navadno besedilo. Neobvezno: slika ob besedilu (image, imageSide left/right) in podpis umetnice pod besedilom (showSignature). Kdaj: Za opise, biografijo, izobrazbo, uvode v razdelke. Za besedilo s fotografijo ob strani dodaj image."},{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"type":{"type":"string","const":"cards"},"heading":{"type":"string","minLength":1,"maxLength":80},"lead":{"type":"string","minLength":1,"maxLength":160},"items":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"title":{"type":"string","minLength":1,"maxLength":60},"image":{"type":"object","properties":{"src":{"type":"string","pattern":"^\\/uploads\\/[a-z0-9\\-_./]+\\.(jpg|jpeg|png|webp|avif|svg)$"},"alt":{"allOf":[{"type":"string","minLength":1,"maxLength":150},{"type":"string","minLength":3}]},"focal":{"type":"string","enum":["center","top","bottom","left","right"],"default":"center"}},"required":["src","alt"],"additionalProperties":false},"description":{"type":"string","minLength":1,"maxLength":300},"page":{"type":"string","pattern":"^[a-z0-9-]+$"}},"required":["id","title