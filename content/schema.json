lates"],"additionalProperties":false},"minItems":1,"maxItems":6},"commission":{"type":"object","properties":{"text":{"type":"string","minLength":1,"maxLength":70},"sub":{"type":"string","minLength":1,"maxLength":80},"sealText":{"type":"string","minLength":1,"maxLength":70},"sealLabel":{"type":"string","minLength":1,"maxLength":80},"page":{"type":"string","pattern":"^[a-z0-9-]+$"}},"required":["text","sealText","sealLabel","page"],"additionalProperties":false}},"required":["id","type","heading","eyebrow","intro","sections"],"additionalProperties":false,"description":"Stran v slogu muzejskega kataloga. Levo katalogni list (eyebrow, podatki facts, uvodno besedilo intro, podpis umetnice, samodejno kazalo), desno velik naslov iz dveh besed (pokončna + ležeča) in vrstice sklopov. Vsak sklop ima rimsko številko, naslov, povezavo na stran sklopa, 2–3 kratke oznake (meta), opombo, sličice (plates) in delo, ki se ob prehodu z miško dvigne (feature). Sličice in feature so sklici na dela iz bloka gallery na strani sklopa ({ page, work }). Spodaj neobvezen poziv za naročila z vrtečim se pečatom (commission). Kdaj: Na strani artwork. Ko stranka želi spremeniti uvodno besedilo, zamenjati sličice ali izpostavljeno delo sklopa, dodati sklop ali spremeniti poziv za naročila. Novo delo najprej dodaj v galerijo na strani sklopa, nato ga tu navedi po id-ju."},{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"type":{"type":"string","const":"gallery"},"groups":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"label":{"type":"string","minLength":1,"maxLength":80},"works":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"number":{"type":"string","minLength":1,"maxLength":6},"title":{"type":"string","minLength":1,"maxLength":60},"details":{"type":"string","minLength":1,"maxLength":160},"image":{"type":"object","propertie